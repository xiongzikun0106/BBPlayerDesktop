{
	"name": "bbplayer-root",
	"private": true,
	"workspaces": [
		"apps/*",
		"apps/*/web",
		"packages/*",
		"packages/*/example"
	],
	"scripts": {
		"check:core": "node scripts/check-core-purity.mjs",
		"check:deps": "syncpack list-mismatches",
		"fix:deps": "syncpack fix-mismatches",
		"format": "oxfmt --write .",
		"lint": "oxlint --type-aware",
		"lint:fix": "oxlint --type-aware --fix",
		"postinstall": "lefthook install",
		"publish:update": "pnpm --filter @bbplayer/update-publisher start",
		"type-check": "tsgo --build --noEmit",
		"verify:backup": "pnpm exec tsx scripts/verify-backup.mts",
		"verify:backup:webdav": "pnpm exec tsx scripts/verify-backup-webdav.mts",
		"verify:desktop": "node scripts/verify-desktop.mjs",
		"verify:desktop:download": "node scripts/verify-download.mjs",
		"verify:desktop:icons": "node scripts/verify-thumbar-icons.mjs",
		"verify:desktop:login": "node scripts/verify-desktop-login.mjs",
		"verify:desktop:media": "node scripts/verify-desktop-media.mjs",
		"verify:desktop:ui": "node scripts/verify-desktop-ui.mjs",
		"verify:login": "pnpm exec tsx scripts/verify-bilibili-login.mts"
	},
	"devDependencies": {
		"@bbplayer/eslint-plugin": "workspace:*",
		"@dword-design/eslint-plugin-import-alias": "^6.0.3",
		"@tanstack/eslint-plugin-query": "^5.101.4",
		"@types/node": "^25.2.3",
		"@typescript/native-preview": "beta",
		"eslint-plugin-drizzle": "^0.2.3",
		"eslint-plugin-react-compiler": "19.1.0-rc.1",
		"eslint-plugin-react-hooks-extra": "^1.53.1",
		"eslint-plugin-react-you-might-not-need-an-effect": "^0.5.6",
		"gifenc": "^1.0.3",
		"lefthook": "^2.1.10",
		"oxfmt": "^0.27.0",
		"oxlint": "^1.78.0",
		"oxlint-tsgolint": "^7.0.2001",
		"syncpack": "^13.0.4",
		"typescript": "~6.0.3"
	},
	"packageManager": "pnpm@11.25.0"
}
